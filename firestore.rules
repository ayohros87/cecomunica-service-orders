rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────────────────────────────────────────────────
    // Reglas explícitas por colección (SIN catch-all) — EN PRODUCCIÓN.
    //
    // CONTEXTO: existía un catch-all `match /{document=**}` con read+write
    // para todo autenticado. Por la semántica OR de Firestore (si CUALQUIER
    // match concede, se permite) ese catch-all SOMBREABA las reglas más
    // estrictas — eran inertes. Se eliminó y cada colección está enumerada;
    // toda colección NO listada queda denegada por defecto. Si el frontend
    // estrena una colección nueva, hay que agregarla aquí o verá
    // "Missing or insufficient permissions".
    //
    // Validación: harness en functions/test-emulator/rules.js (73 grupos),
    // corre con `firebase emulators:exec --only firestore --project demo-ci
    // "node functions/test-emulator/rules.js"`. Censo de colecciones del
    // cliente cruzado contra este archivo el 2026-08-19: cobertura completa.
    // ───────────────────────────────────────────────────────────────────────

    function isSignedIn() { return request.auth != null; }

    function userRole() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }
    function isAdmin()    { return isSignedIn() && userRole() == "administrador"; }
    // Cotizaciones: aprobación separada por TIPO (ver match /cotizaciones).
    //   puedeCotizar → crear/listar;  verTodasCot → ver/editar/borrar cualquiera (como admin).
    //   gerente: incluido para que pueda revisar y aprobar cotizaciones comerciales.
    function puedeCotizar() { return isSignedIn() && userRole() in ["administrador", "vendedor", "jefe_taller", "recepcion", "gerente"]; }
    function verTodasCot()  { return isSignedIn() && userRole() in ["administrador", "jefe_taller", "gerente"]; }
    // Supervisión de cotizaciones (coordinación de ventas): emails en
    // empresa/config.cotizaciones_supervisores pueden VER todas las
    // cotizaciones (get/list) sin importar su rol. Solo lectura: no se
    // concede en create/update/delete. La allowlist guarda emails en
    // minúsculas (admin-config los normaliza al guardar).
    function esSupervisorCot() {
      return isSignedIn()
        && ("email" in request.auth.token)
        && request.auth.token.email.lower()
             in get(/databases/$(database)/documents/empresa/config).data.get("cotizaciones_supervisores", []);
    }
    // Suplencia del control de calidad del taller. El QC lo firma jefe_taller
    // (hoy una sola persona: si falta, la cola de entregas se detiene porque
    // nadie más puede aprobar). Los emails en empresa/config.qc_revisores_extra
    // pueden firmar QC sin cambiar de rol — mismo patrón de allowlist que
    // cotizaciones_supervisores y seriales_editores_extra. La UI
    // (ordenes-qc.js: puedeHacerQc) lee la misma lista.
    function esRevisorQcExtra() {
      return isSignedIn()
        && ("email" in request.auth.token)
        && request.auth.token.email.lower()
             in get(/databases/$(database)/documents/empresa/config).data.get("qc_revisores_extra", []);
    }
    // Gestión de seriales del contrato (subcolecciones seriales/seriales_estado/
    // seriales_historial). Refleja el permiso 'gestionar-seriales' de roles.js.
    // Cierra el hueco por el que CUALQUIER autenticado podía escribir seriales.
    // El candado fino "solo admin/allowlist tras asignados" vive en la UI
    // (contrato-seriales-page.js + empresa/config.seriales_editores_extra).
    function puedeGestionarSeriales() { return isSignedIn() && userRole() in ["administrador", "recepcion", "vendedor", "gerente", "inventario"]; }
    // Solicitar cambio/corrección de serial (recepción/admin) — solo mientras el
    // contrato está 'aprobado' (antes de activarse). Ver match /seriales_cambios.
    function puedeSolicitarCambioSerial() { return isSignedIn() && userRole() in ["administrador", "recepcion"]; }

    // Campos cuyo dueño exclusivo es Cloud Functions (admin SDK los salta).
    // Sólo bloquea escrituras desde el frontend que CAMBIEN estos campos. Se
    // evalúa sobre las claves AFECTADAS (diff), no sobre su mera presencia: en un
    // `update`, request.resource.data es el doc COMPLETO resultante, así que
    // comprobar `"X" in incoming` bloqueaba cualquier edición de un contrato que
    // ya tuviera firma_*/os_* estampados por la CF (aunque no se tocaran).
    //   NOTA: `fecha_aprobacion` NO va aquí — el frontend lo estampa al aprobar
    //   (contratos-approval.js); la CF onContratoActivado solo lo rellena/repara.
    function touchesCFOwnedFields() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasAny([
        "firma_codigo", "firma_hash", "firma_url",
        "os_count", "equipos_total", "tiene_os", "os_linked",
        "os_serials_preview", "os_has_equipos", "os_last_orden_id",
        "os_equipos_count_last", "os_dirty",
        // Espejo del pendiente de devolución (onOrdenDevolucionWrite) y
        // back-pointer de linaje (onLinajeWrite): la lista de contratos los
        // lee para el chip, así que nadie debe poder falsear "ya devolvió".
        "devolucion_tiquetes", "devolucion_pendientes", "devolucion_esperado",
        "devolucion_estado", "devolucion_actualizado_at", "renovado_por_ids",
        // Facturación (H8, propuesta Almacén/Finanzas 2026-08): estos campos
        // los escribe SOLO el callable gestionarFacturacion (rol-gated) y los
        // triggers (onOrdenEntregada, facturacionDiaria, onAnnulment). El
        // frontend únicamente los LEE (verificado 2026-08-10) — sin este
        // candado cualquier autenticado podía marcar un contrato como
        // facturando/no facturable esquivando el callable.
        "facturacion_estado", "facturacion_fecha_inicio", "facturable",
        "facturacion_no_aplica_motivo", "facturacion_activada_por",
        "facturacion_activada_at", "facturacion_gestionado_por",
        "facturacion_gestionado_at", "entrega_confirmada",
        "entrega_confirmada_manual", "fecha_entrega_ultima",
        "facturacion_entrega_at",
        // Vigencia del contrato (Ola 1 gestiones por cliente, 2026-08-26): la
        // estampan onContratoActivado / backfill y la mantiene el cron
        // (recordatorioOperativo sección H). La lista y el Centro de gestión
        // pintan la señal "por vencer" con estos campos — nadie debe poder
        // correr un vencimiento a mano; una corrección real va por script.
        "fecha_vencimiento", "vencimiento_estado", "vencimiento_estado_at",
        "vigencia"
      ]);
    }

    // ── Usuarios ──────────────────────────────────────────────────────────
    // Lectura para cualquier autenticado (la app resuelve roles/nombres).
    // Escritura SOLO vía callable `manageUser` (admin SDK) → write:false en cliente.
    // Verificado: no hay db.collection('usuarios').set/update/add desde el frontend.
    match /usuarios/{userId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // Auditoría de usuarios — escrita por Cloud Functions (admin SDK).
    // El cliente sólo la lee (auditoriaService). write:false.
    match /usuarios_audit/{docId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ── Cotizaciones (ENFORCED) ───────────────────────────────────────────
    // Acceso: administrador y vendedor. El vendedor sólo accede a las propias
    // por id (get); la aprobación queda reservada a administradores.
    //
    // NOTA sobre `list`: el listado actual (cotizaciones-index) trae todas y
    // filtra "solo mías" en cliente, así que `list` se concede a todo el rol
    // ventas. Para AISLAR la lista por vendedor a nivel de reglas hace falta:
    //   1) que la query incluya .where('creado_por_uid','==',uid) para vendedores
    //      (cotizacionesService.listCotizaciones + busquedaGlobal),
    //   2) un índice compuesto (creado_por_uid ASC, fecha_creacion DESC),
    //   3) cambiar la regla `list` de abajo a la variante por-dueño.
    // El `get` por id YA está aislado (editar/detalle/imprimir por URL ajena fallan).
    match /cotizaciones/{docId} {
      function esDueno() {
        return isSignedIn() && resource.data.creado_por_uid == request.auth.uid;
      }
      // ¿La escritura intenta aprobar (transición a 'aprobada') o estampar
      // los campos de aprobación?
      function aprobacionTocada() {
        let after = request.resource.data;
        let changed = after.diff(resource.data).affectedKeys();
        return (after.estado == "aprobada" && resource.data.estado != "aprobada")
            || changed.hasAny(["fecha_aprobacion", "aprobado_por_uid", "aprobado_por_email"]);
      }
      // Tipo de cotización: 'orden' (servicio, sale de una orden de taller) vs
      // comercial. Las legacy sin `origen` se tratan como comerciales. Se lee del
      // doc EXISTENTE (resource), no del entrante, para que nadie eleve el tipo en
      // la misma escritura de aprobación (p.ej. comercial→'orden' para saltarse al gerente).
      function cotEsServicio() {
        return resource.data.get("origen", "comercial") == "orden";
      }
      // Técnicos de taller: PREPARAN cotizaciones de servicio (origen=orden) en
      // borrador desde una orden. No crean comerciales ni envían/aprueban: el
      // envío al cliente y la aprobación quedan para el supervisor (jefe_taller).
      function esTecnicoTaller() {
        return isSignedIn() && userRole() in ["tecnico", "tecnico_operativo"];
      }
      function entranteEsServicio() {
        return request.resource.data.get("origen", "comercial") == "orden";
      }
      // Umbral de envío (antes era gate solo-UI): un no-aprobador solo puede
      // mover su cotización a 'enviada' si está dentro de política (descuento
      // y total contra empresa/config, mismos defaults que
      // CotizacionesTotales.POLICY_DEFAULT) o si ya fue aprobada internamente
      // (p.ej. reenvío de una vencida que sí pasó aprobación).
      function envioTocado() {
        return request.resource.data.estado == "enviada" && resource.data.estado != "enviada";
      }
      function politicaEnvioOk() {
        let cfg = get(/databases/$(database)/documents/empresa/config).data;
        return request.resource.data.get("descuentoPct", 0) <= cfg.get("cotizacion_descuento_max_pct", 15)
            && request.resource.data.get("total", 0) <= cfg.get("cotizacion_total_max", 5000)
            // Descuento POR LÍNEA (auditoría A10): rules no puede recorrer
            // renglones, así que manda el flag `requiere_aprobacion` que la
            // app estampa en CADA guardado (incluye el mayor descuento de
            // línea desde 2026-08-17) — 40% por línea con total $4,900 ya no
            // se envía sin aprobación. Docs previos sin el campo pasan como
            // antes (default false): sin regresión sobre borradores viejos.
            && request.resource.data.get("requiere_aprobacion", false) == false;
      }
      function aprobadaAntes() {
        return resource.data.get("fecha_aprobacion", null) != null;
      }

      allow get:  if verTodasCot() || esDueno() || esSupervisorCot();
      // `list` lo usa la generación del correlativo (nextCotizacionId); se concede
      // también a técnicos de taller para que el id no colisione al preparar.
      allow list: if puedeCotizar() || esTecnicoTaller() || esSupervisorCot();

      allow create: if (puedeCotizar() || (esTecnicoTaller() && entranteEsServicio()))
                     && request.resource.data.creado_por_uid == request.auth.uid
                     && (request.resource.data.estado == "borrador" || isAdmin());

      // Envío del dueño (estado→enviada) no es aprobacionTocada → vendedor envía lo
      // suyo. La APROBACIÓN se separa por tipo: servicio la aprueba el jefe de
      // mantenimiento (jefe_taller); comercial, el gerente; admin cualquiera.
      // Un técnico de taller solo puede mantener SU borrador (editarlo): no puede
      // moverlo a 'enviada' ni 'aprobada' — eso lo hace el supervisor.
      allow update: if (verTodasCot() || esDueno())
                     && (!esTecnicoTaller() || request.resource.data.estado == "borrador")
                     && (isAdmin()
                         || !aprobacionTocada()
                         || (userRole() == "jefe_taller" && cotEsServicio())
                         || (userRole() == "gerente" && !cotEsServicio()))
                     // Política de envío ENFORCED: fuera de umbral y sin
                     // aprobación previa, el envío queda para el aprobador
                     // del tipo (jefe_taller→servicio, gerente→comercial).
                     && (!envioTocado()
                         || isAdmin()
                         || (userRole() == "jefe_taller" && cotEsServicio())
                         || (userRole() == "gerente" && !cotEsServicio())
                         || aprobadaAntes()
                         || politicaEnvioOk());

      allow delete: if verTodasCot();
    }

    // ── Correlativos secuenciales ─────────────────────────────────────────
    // contadores/cotizaciones_{año}:            correlativo COT-YYYY-NNNN.
    // contadores/contratos_{TIPO}_{YYYYMMDD}:   sufijo del número de contrato.
    // Ambos se leen e incrementan en una transacción para que dos creaciones
    // simultáneas no repitan número (regresiones históricas: COT-2026-0012 salió
    // en 3 documentos; ALQ20260723-01 también, ese por zona horaria). Los
    // escriben los mismos actores que crean cotizaciones y contratos:
    // puedeCotizar() + los técnicos que PREPARAN cotizaciones de servicio desde
    // una orden. Nunca se borra: un contador que retrocede recicla números.
    match /contadores/{docId} {
      allow read:           if isSignedIn();
      allow create, update: if isSignedIn()
        && userRole() in ["administrador","vendedor","jefe_taller","recepcion","gerente","tecnico","tecnico_operativo"];
      allow delete:         if false;
    }

    // ── Cotizaciones públicas (sin cambios) ───────────────────────────────
    // Mirror público de cotizaciones aprobadas. Creado por la app autenticada
    // (admin que aprueba); leído por cualquiera con el code en el URL.
    match /cotizacion_verificaciones/{docId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Log de aperturas desde el link público. Cualquiera puede crear (POST simple,
    // no se expone PII más allá de user-agent/referrer). Lectura solo autenticada.
    match /cotizacion_opens/{logId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['verificacion_id', 'cotizacion_id', 'code',
                          'opened_at', 'user_agent', 'referrer'])
                       && request.resource.data.verificacion_id is string
                       && request.resource.data.code is string;
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    // ── Contratos (intención previa conservada) ───────────────────────────
    match /contratos/{docId} {
      // Activación por contrato FIRMADO: el vendedor (o admin) sube el PDF
      // firmado de un contrato APROBADO y ese mismo write lo pasa a 'activo'
      // (contratos-upload.js — es la vía legítima de activación desde ventas,
      // y la UI ya ofrece "Subir firmado" a admin/vendedor). El guard general
      // de abajo reserva el salto a 'activo' a admin/gerente, así que aquí se
      // exceptúa SOLO cuando el write parte de 'aprobado' y estampa firmado=true
      // + firmado_url. Cualquier otro salto a 'activo' sigue cerrado.
      function esActivacionPorFirmado() {
        return resource.data.estado == "aprobado"
            && request.resource.data.get("firmado", false) == true
            && request.resource.data.diff(resource.data).affectedKeys().hasAny(["firmado_url"])
            && userRole() in ["administrador", "vendedor"];
      }
      // Descarte de la orden de programación ("esta orden no se va a crear"):
      // solo lo escribe quien ve la bandeja del home — recepción y admin. La
      // UI ya lo gatea; esto es el piso de rol, para que el campo que apaga el
      // CTA de la lista de contratos no lo pueda poner cualquier autenticado.
      function tocaDescarteOrdenProg() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(["orden_prog_descartada"]);
      }
      // Reemplazo del PDF firmado (contratos-upload.js, modo 'reemplazo'): el
      // archivo saliente se archiva en firmado_historial[] y de ahí sale el
      // evento REEMPLAZAR_FIRMADO de la auditoría. Sustituir el papel de un
      // contrato vivo puede ser legítimo (se subió el contrato sin firmar),
      // pero no puede ser silencioso: la lista solo crece. Mismo criterio que
      // devolucionAppendOnly con los acuses. Admin exento para correcciones.
      function firmadoHistorialAppendOnly() {
        return resource.data.get("firmado_historial", []).size()
            <= request.resource.data.get("firmado_historial", []).size()
          || userRole() == "administrador";
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && !touchesCFOwnedFields()
        && firmadoHistorialAppendOnly()
        && (!tocaDescarteOrdenProg() || userRole() in ["administrador", "recepcion"])
        && (!(resource.data.estado != "activo" && request.resource.data.estado == "activo")
            || userRole() in ["administrador", "gerente"]
            || esActivacionPorFirmado());
      allow delete: if isSignedIn() && (userRole() in ["administrador", "gerente"]);

      // Lectura de CUALQUIER subcolección de contrato para autenticados (ordenes,
      // seriales, seriales_estado, seriales_historial, …). La escritura NO se
      // concede de forma recursiva: se otorga por subcolección más abajo, para
      // que las reglas específicas no queden sombreadas por el OR de Firestore.
      match /{sub=**} {
        allow read: if isSignedIn();
      }

      // Subcolección `ordenes` (cache de órdenes vinculadas). Además de las Cloud
      // Functions, el cliente escribe aquí vía contratosService.linkOrden() /
      // .unlinkOrden() (contratos-equipos.js, editar-orden.js).
      match /ordenes/{ordenId} {
        allow write: if isSignedIn();
      }

      // Seriales del contrato — escritura restringida al rol que los gestiona.
      // (El candado "solo admin/allowlist tras asignados" es adicional y vive en
      // la UI; a nivel de reglas basta con cerrar el rol.)
      match /seriales/{serialId}          { allow write: if puedeGestionarSeriales(); }
      match /seriales_estado/{docId2}     { allow write: if puedeGestionarSeriales(); }
      match /seriales_historial/{docId2}  { allow write: if puedeGestionarSeriales(); }

      // Solicitudes de cambio de serial. Decisión 2026-08-26 (#11, Ola 5): un
      // serial mal capturado se corrige EN CUALQUIER MOMENTO — la ventana la
      // define el estado del EQUIPO, no el papel del contrato (antes exigía
      // contrato 'aprobado' y un error detectado tras activar quedaba
      // incorregible). El control es la aprobación: resolver (estado→'resuelto')
      // sigue reservado a quien gestiona seriales, con kardex correccion_serial.
      match /seriales_cambios/{reqId} {
        allow create: if puedeSolicitarCambioSerial();
        allow update: if puedeGestionarSeriales();
        allow delete: if isAdmin();
      }

      // Mapeos de transición (renovación/reemplazo): registro durable
      // saliente→entrante por serial (PLAN_CICLO_VIDA_EQUIPOS.md C.2). El
      // trigger onMapeoWrite aplica el linaje al pool (reemplaza_a +
      // pendiente_devolucion) con Admin SDK. Append-only: corregir = admin.
      match /mapeos/{mapeoId} {
        allow create: if puedeGestionarSeriales();
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ── Verificaciones de contratos (público, sin cambios) ────────────────
    match /verificaciones/{contratoId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Resto de colecciones — comportamiento preservado (auth read+write) ──
    // Estas NO se endurecen en este cambio (enfocado en cotizaciones). El
    // wildcard `{sub=**}` cubre subcolecciones (clientes/documentos,
    // ordenes_de_servicio/consumos, ordenes_de_servicio/equipos_meta, etc.).

    match /clientes/{docId} {
      allow read, create, delete: if isSignedIn();
      // El vínculo con QuickBooks decide a QUIÉN se le facturará: solo lo
      // cambian admin/contabilidad (la página de match ya gateaba en UI; H8).
      allow update: if isSignedIn()
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(["qbo_customer_id", "qbo_customer_name"])
            || userRole() in ["administrador", "contabilidad"]);
      // OJO (rules v2): `/{sub=**}` a secas matchea CERO segmentos y alcanza el
      // doc padre, anulando el candado de update de arriba (verificado en el
      // harness). El segmento nombrado obliga a que sea una subcolección real.
      // `historial` lo escribe SOLO el trigger onClienteHistorial (Admin SDK):
      // el rastro de quién cambió qué es inmutable desde el cliente.
      match /{subcol}/{sub=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && subcol != "historial";           // documentos
      }
    }

    match /ordenes_de_servicio/{docId} {
      // Máquina de estados de la orden — el flujo que la UI impone con botones
      // ahora también se exige aquí: una escritura directa no puede saltar a un
      // estado arbitrario. Espeja botonesFlujo (ordenes-render.js), incluidos
      // el atajo "saltar recepción" y los dos caminos a CERRADA (VISITA)
      // (cierre normal y regularización de visita legacy en COMPLETADO).
      // ENTREGADO y CERRADA son terminales. Un estado legacy fuera del enum
      // canónico puede regularizarse hacia cualquiera. Admin sin restricción
      // (correcciones manuales / reversas).
      function ordenTransicionLegal() {
        let de = resource.data.get("estado_reparacion", "POR ASIGNAR");
        let a  = request.resource.data.get("estado_reparacion", "POR ASIGNAR");
        return de == a
          || !(de in ["POR ASIGNAR", "RECIBIDO EN MOSTRADOR", "ASIGNADO",
                      "COMPLETADO (EN OFICINA)", "ENTREGADO AL CLIENTE",
                      "CERRADA (VISITA)", "CERRADA (DEVOLUCION)", "CERRADA (ENTRADA)"])
          || (de == "POR ASIGNAR" && a in ["RECIBIDO EN MOSTRADOR", "ASIGNADO", "CERRADA (DEVOLUCION)"])
          || (de == "RECIBIDO EN MOSTRADOR" && a == "ASIGNADO")
          || (de == "ASIGNADO" && a in ["COMPLETADO (EN OFICINA)", "CERRADA (VISITA)", "CERRADA (DEVOLUCION)"])
          // CERRADA (ENTRADA): terminal de las órdenes de ENTRADA (inspección
          // de devueltos) — cierran sin entrega ni QC; las unidades quedan
          // bajo control de inventario (bodega/baja por serial).
          || (de == "COMPLETADO (EN OFICINA)" && a in ["CERRADA (VISITA)", "CERRADA (ENTRADA)"])
          // Candado de control de calidad (ordenes-qc.js): las órdenes
          // completadas post-despliegue llevan qc_requerido:true (lo estampa
          // completeOrder) y solo pueden entregarse con qc.resultado ==
          // 'aprobado' del jefe de taller. Las completadas ANTES no llevan la
          // marca y quedan exentas (corte legacy, mismo patrón que seriales).
          // Una ENTRADA NO se entrega al cliente: el equipo vuelve, no sale.
          // Su terminal es CERRADA (ENTRADA) (arriba). La UI ya oculta el botón
          // "Entregar" para estas órdenes desde 2026-07-21, pero las reglas lo
          // seguían permitiendo — y las 191 ENTRADAs anteriores a esa fecha
          // quedaron mal cerradas, lo que además empujó sus unidades a
          // en_cliente vía onOrdenWritePool.
          || (de == "COMPLETADO (EN OFICINA)" && a == "ENTREGADO AL CLIENTE"
              && resource.data.get("tipo_de_servicio", "") != "ENTRADA"
              && (resource.data.get("qc_requerido", false) != true
                  || (resource.data.get("qc", {}).get("resultado", "") == "aprobado"
                      && qcCubreLosEquipos())))
          // Rechazo de QC: única reversa permitida del flujo — el MISMO write
          // debe estampar qc.resultado='rechazado' (saveQcRechazado) y la
          // orden vuelve al técnico para corrección. Exigir que el write TOQUE
          // `qc` es lo que hace real esa condición: sin ello bastaba con que el
          // doc arrastrara un rechazo VIEJO (los `set(…,{merge:true})` reenvían
          // el campo intacto) para que cualquier rol devolviera la orden al
          // técnico sin una nueva pasada de QC. Y como tocar `qc` exige
          // jefe_taller/admin (qcFieldsUntouchedOrJefe), la reversa vuelve a ser
          // exclusiva de quien puede rechazar.
          || (de == "COMPLETADO (EN OFICINA)" && a == "ASIGNADO"
              && request.resource.data.get("qc", {}).get("resultado", "") == "rechazado"
              && request.resource.data.diff(resource.data).affectedKeys().hasAny(["qc"]));
      }
      // El QC aprobado cubre los equipos que tenía la orden CUANDO se firmó:
      // saveQcAprobado estampa qc.equipos_n con ese conteo. "Agregar equipo" y
      // "Nuevo batch" siguen disponibles en COMPLETADO, así que sin esta
      // comparación se podía aprobar el QC de 5 radios, sumar un batch de 10 y
      // entregar los 15 con la leyenda "QC aprobado" en la nota — 10 de ellos
      // sin revisar. Al cambiar el conteo el QC caduca y hay que repetirlo.
      // equipos_n ausente (-1) = aprobado antes de este cambio: se acepta para
      // no bloquear las órdenes que ya estaban esperando entrega.
      function qcCubreLosEquipos() {
        let n = resource.data.get("qc", {}).get("equipos_n", -1);
        return n == -1 || n == resource.data.get("equipos", []).size();
      }
      // Una aprobación de QC debe traer el checklist completo. La UI ya
      // deshabilita "Aprobar" hasta marcar todos los puntos (OK o N/A), pero
      // eso vivía SOLO en el botón: un write directo podía estampar
      // qc.resultado='aprobado' con checklist vacío y la nota de entrega
      // igual imprimía la leyenda ante el cliente.
      // ⚠️ Los mínimos espejan QC_CHECKLISTS en ordenes-qc.js (programación 5
      // ítems, reparación 4). Si agregas ítems allá, súbelos aquí.
      // Solo se evalúa en el write que TOCA `qc`: un `set(…,{merge:true})`
      // reenvía el campo intacto en cada edición posterior de la orden, así
      // que sin este corte la validación se aplicaría también a la entrega y
      // a cualquier otra escritura sobre una orden ya aprobada.
      function qcAprobadoTraeChecklist() {
        let qc = request.resource.data.get("qc", {});
        let n = qc.get("checklist", {}).keys().size();
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["qc"])
          || qc.get("resultado", "") != "aprobado"
          || (qc.get("tipo", "") == "programacion" ? n >= 5 : n >= 4);
      }
      // qc_requerido es la marca que enciende el candado. Queda FUERA del guard
      // de campos de QC porque la estampa completeOrder, que corren también
      // técnicos y recepción — pero solo puede encenderse, nunca apagarse: si
      // no, bastaban dos escrituras para saltarse el control (1: qc_requerido a
      // false con el estado intacto; 2: pasar a ENTREGADO, porque el candado
      // lee `resource.data`, ya sin la marca). La excepción es ENTRADA, que
      // completa con qcRequerido:false por diseño (cierra sin entrega).
      // Admin queda exento por el OR de isAdmin() en el allow.
      function qcRequeridoNoSeApaga() {
        return resource.data.get("qc_requerido", false) != true
          || request.resource.data.get("qc_requerido", false) == true
          || request.resource.data.get("tipo_de_servicio", "") == "ENTRADA";
      }
      // La otra mitad del mismo candado: al COMPLETAR, la marca tiene que
      // quedar encendida. Sin esto el bypass seguía en pie en un solo write
      // (completar y desactivar el control a la vez), porque qcRequeridoNoSeApaga
      // mira el documento PREVIO, que todavía no traía la marca.
      // Excepciones: ENTRADA (cierra sin entrega) y las órdenes que YA estaban
      // en COMPLETADO antes del corte, que se siguen editando sin la marca.
      function qcMarcaAlCompletar() {
        return request.resource.data.get("estado_reparacion", "") != "COMPLETADO (EN OFICINA)"
          || resource.data.get("estado_reparacion", "") == "COMPLETADO (EN OFICINA)"
          || request.resource.data.get("qc_requerido", false) == true
          || request.resource.data.get("tipo_de_servicio", "") == "ENTRADA";
      }
      // Los campos de QC (resultado vigente + historial) solo los escriben
      // jefe_taller/admin — el resto de roles puede seguir editando la orden
      // mientras no los toque. qc_requerido queda fuera del guard: lo estampa
      // completeOrder, que ejecutan también técnicos y recepción.
      function qcFieldsUntouchedOrJefe() {
        return !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(["qc", "qc_historial"])
          || userRole() in ["administrador", "jefe_taller"]
          || esRevisorQcExtra();
      }
      // DEVOLUCIÓN — el acuse firmado es el papel que se lleva el cliente, y su
      // copia (devolucion.acuses[].unidades) dice exactamente qué accesorios
      // entregó. Recepción puede corregir lo registrado MIENTRAS no haya firma
      // (ordenes-devolucion.js: puedeCorregir), pero después no: el sistema no
      // debe terminar diciendo algo distinto al papel del cliente.
      // El candado por unidad vive en la UI porque las reglas no pueden
      // recorrer un array elemento por elemento. Lo que sí se cierra aquí es
      // el atajo: borrar el acuse (o la unidad) para volver a dejarla editable.
      // Las dos listas solo crecen; el backend (Admin SDK) no pasa por aquí y
      // admin queda exento arriba para correcciones manuales.
      function devolucionAppendOnly() {
        let antes   = resource.data.get("devolucion", {});
        let despues = request.resource.data.get("devolucion", {});
        return antes.get("acuses", []).size() <= despues.get("acuses", []).size()
          && antes.get("esperados", []).size() <= despues.get("esperados", []).size();
      }
      // Borrado lógico (auditoría órdenes P2): `eliminado:true` saca la orden
      // de TODA la operación (bandeja, señales, conteos) — merece candado
      // propio. Para roles no-admin: solo recepción lo enciende (espeja el
      // menú ⋯ de la UI), siempre con motivo (≥10 chars, el mínimo que pide
      // la UI), nunca sobre una orden terminal (entregada/cerrada es historial
      // del cliente con firma y QC) y nunca en reversa (true→false) — las
      // resurrecciones son correcciones manuales de admin, que queda exento
      // por el OR de isAdmin() en el allow.
      function eliminadoOk() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["eliminado"])
          || (request.resource.data.get("eliminado", false) == true
              && resource.data.get("eliminado", false) != true
              && userRole() == "recepcion"
              && request.resource.data.get("eliminado_motivo", "").size() >= 10
              && !(resource.data.get("estado_reparacion", "POR ASIGNAR")
                     in ["ENTREGADO AL CLIENTE", "CERRADA (VISITA)",
                         "CERRADA (DEVOLUCION)", "CERRADA (ENTRADA)"]));
      }
      allow read: if isSignedIn();
      // create/update solo para los roles que operan órdenes (permiso 'crear-orden'
      // en roles.js): admin/vendedor/recepción/técnico/técnico_operativo/jefe_taller.
      // Excluye gerente/inventario/contabilidad/vista, que no editan órdenes.
      allow create: if isSignedIn()
        && userRole() in ["administrador","vendedor","recepcion","tecnico","tecnico_operativo","jefe_taller"];
      allow update: if isSignedIn()
        && userRole() in ["administrador","vendedor","recepcion","tecnico","tecnico_operativo","jefe_taller"]
        && (isAdmin() || (ordenTransicionLegal() && qcFieldsUntouchedOrJefe()
                          && qcAprobadoTraeChecklist() && qcRequeridoNoSeApaga()
                          && qcMarcaAlCompletar() && devolucionAppendOnly()
                          && eliminadoOk()));
      // El cliente nunca hace hard-delete de una orden a nivel doc (verificado:
      // solo borra líneas de la subcolección `consumos`; los borrados de orden
      // pasan por consola/admin SDK y la CF onOrdenHardDelete limpia después).
      // Restringir delete a admin/gerente cierra el borrado de órdenes de negocio
      // por cualquier rol, sin afectar el borrado de consumos (regla sub=** abajo).
      allow delete: if isSignedIn() && userRole() in ["administrador","gerente"];
      // Subcolecciones EXPLÍCITAS (no un {sub=**} recursivo): en rules_version 2 el
      // wildcard recursivo también matchea el DOC PADRE, y su `write` sombreaba las
      // restricciones de create/update/delete de la orden — anulándolas por el OR.
      match /consumos/{c}              { allow read, write: if isSignedIn(); }
      match /equipos_meta/{m}          { allow read, write: if isSignedIn(); }
      match /borradores_cotizacion/{b} { allow read, write: if isSignedIn(); }
    }

    match /poc_devices/{docId} {
      // unit_id SIEMPRE string y unit_id_num su espejo numérico (int|null) para
      // ordenar — el import de Excel escribía unit_id como number y Firestore
      // (que ordena por tipo primero) partía la lista en dos bloques. Se evalúa
      // sobre el doc resultante: toda la colección quedó saneada por el
      // backfill 2026-07-21, así que ningún update hereda un valor inválido.
      function pocTiposOk() {
        let d = request.resource.data;
        return (!('unit_id' in d) || d.unit_id is string)
            && (!('unit_id_num' in d) || d.unit_id_num == null || d.unit_id_num is int);
      }
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && pocTiposOk();
      // El cliente solo hace soft-delete (update deleted:true); el hard-delete a
      // nivel doc queda para admin.
      allow delete: if isAdmin();
      // sub=** SOLO lectura: poc_devices no tiene subcolecciones escritas, y un
      // {sub=**} con write sombreaba el delete:isAdmin de arriba (ver órdenes).
      match /{sub=**} { allow read: if isSignedIn(); }
    }

    // Pool de SIM cards (POC/sim-cards.html + asignación desde la lista POC).
    // Doc ID = ICCID. Mismo criterio de escritura que poc_devices (recepción
    // opera el pool); hard-delete solo admin (SIMs cargados por error).
    match /sim_cards/{simId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Pool de equipos serializados (inventario/equipos.html; asignación a
    // contratos desde contratos/seriales.html). Doc ID = serial normalizado,
    // con failsafe de colisión entre modelos vía ID sufijado `serial__modelo`
    // (ver docs/plans/PLAN_POOL_EQUIPOS_SERIAL.md). Alta/recepción en bodega:
    // admin/inventario. Transiciones desde el flujo de seriales de contrato:
    // puedeGestionarSeriales(). Los cruces con órdenes/entregas/POC los
    // escriben Cloud Functions (Admin SDK — saltan estas reglas). Nunca se
    // borra un doc: la salida es baja lógica (estado 'baja').
    match /equipos_pool/{docId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && userRole() in ["administrador", "inventario"];
      allow update: if puedeGestionarSeriales();
      allow delete: if false;
      // Kardex append-only: los movimientos nunca se editan ni se borran.
      match /movimientos/{mid} {
        allow read:   if isSignedIn();
        allow create: if puedeGestionarSeriales();
        allow update, delete: if false;
      }
    }

    // Equipos descartados en control de calidad. Doc ID = serial normalizado,
    // así que la alerta al teclear un serial (SerialField, en Bodega y Taller)
    // es un solo get por doc-ID, sin índice.
    //   · Lectura: cualquier autenticado — la alerta tiene que salir en TODOS
    //     los puntos de captura de serial, y quien la necesita más es bodega.
    //   · Escritura: los mismos que firman QC (es un resultado del QC), y NO
    //     puedeGestionarSeriales(): jefe_taller no está en esa lista y es
    //     precisamente quien descarta.
    //   · Nunca se borra desde la UI: revocar escribe `revocado: true` y apila
    //     la traza en `historial[]`. El delete queda solo para admin.
    match /equipos_descartados/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && (userRole() in ["administrador", "jefe_taller"] || esRevisorQcExtra());
      allow delete: if isAdmin();
    }

    // Equipos que el cliente NO devolvió y hay que cobrarle (finiquito,
    // pérdida, se los quedó). Un doc por renglón cobrable.
    // Plan: docs/plans/PLAN_EQUIPOS_NO_DEVUELTOS.md.
    //   · Lectura: cualquier autenticado — es la bandeja que impide que la
    //     deuda se traspapele, y cuanta más gente la vea, mejor.
    //   · Alta y ajuste: puedeGestionarSeriales() — los mismos que cierran
    //     devoluciones y los que cobran.
    //   · CONDONAR es perdonar plata: solo administrador. Se aplica en el
    //     servidor de reglas, no solo en la UI — un renglón no puede pasar a
    //     `condonado` si quien escribe no es admin.
    //   · Nunca se borra: los cierres son etapas (facturado / condonado /
    //     recuperado) con su traza en `historial[]`. Un renglón borrado es
    //     exactamente el agujero que este módulo vino a tapar.
    match /cobros_equipos/{docId} {
      allow read:   if isSignedIn();
      allow create: if puedeGestionarSeriales();
      allow update: if puedeGestionarSeriales()
        && (request.resource.data.etapa != "condonado"
            || resource.data.etapa == "condonado"
            || isAdmin());
      allow delete: if false;
    }

    // Modelos: catálogo + tarifas de facturación (info sensible). Lectura para
    // cualquier autenticado (inventario cuenta stock, contratos eligen modelo).
    // Escritura SOLO admin/contabilidad (modelo-de-radio.html ya es admin-only).
    match /modelos/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && userRole() in ["administrador", "contabilidad"];
    }
    // Cargos de facturación (activación, etc.) — info sensible, mismo criterio que modelos.
    match /cargos/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && userRole() in ["administrador", "contabilidad"];
    }
    // Solicitudes de baja de equipos (cancelaciones de contrato).
    // Crear/ver: admin/gerente/vendedor/recepción. Aprobar/rechazar/borrar: admin/gerente.
    match /solicitudes_cancelacion/{docId} {
      allow read:   if isSignedIn() && userRole() in ["administrador","gerente","vendedor","recepcion"];
      allow create: if isSignedIn() && userRole() in ["administrador","gerente","vendedor","recepcion"];
      allow update: if isSignedIn() && userRole() in ["administrador","gerente"];
      allow delete: if isSignedIn() && userRole() in ["administrador","gerente"];
    }
    // ── Gestiones por cliente (Ola 1, ARQUITECTURA_GESTIONES_POR_CLIENTE) ──
    // Una gestión es el expediente de una operación del CLIENTE sobre seriales
    // concretos (reemplazo, demo, baja, aumento, devolución, cambio de serial)
    // y puede cruzar contratos. Nunca se borra: se anula (estado 'anulada'),
    // igual que el resto del sistema.
    // Endurecido por campo (2026-08-31 — la V1 dejaba a cualquier vendedor
    // escribir estado/cierre/aprobacion de cualquier gestión): cada transición
    // legítima de la UI tiene su forma; el avance del expediente (cierre.*,
    // ordenes, derivados) lo escribe Cloud Functions con Admin SDK, que no
    // pasa por estas reglas.
    match /gestiones/{docId} {
      function soloTocaG(ks) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(ks);
      }
      // Aprobar (excepción → bodega · baja → en_proceso · aumento → firma):
      // solo administración/gerencia. La baja NO se aprueba sin la carta del
      // cliente — antes ese candado vivía solo en la página.
      function esAprobacionGestion() {
        return userRole() in ["administrador","gerente"]
          && resource.data.estado == "pendiente_aprobacion"
          && request.resource.data.estado in ["pendiente_bodega","en_proceso","pendiente_firma"]
          && soloTocaG(["estado","aprobacion","cierre"])
          && (resource.data.tipo != "baja"
              || ("carta_path" in resource.data && resource.data.carta_path is string));
      }
      // Anular / rechazar: nunca una cerrada, otra anulada o una ya entregada.
      function esAnulacionGestion() {
        return userRole() in ["administrador","gerente"]
          && request.resource.data.estado == "anulada"
          && !(resource.data.estado in ["cerrada","anulada"])
          && resource.data.get("cierre", {}).get("entrega", false) != true
          && soloTocaG(["estado","anulada_motivo","anulada_por_uid","anulada_at"]);
      }
      // Adjuntar la carta del cliente (baja).
      function esCartaGestion() {
        return userRole() in ["administrador","gerente","vendedor","recepcion"]
          && soloTocaG(["carta_path","carta_at","carta_por"]);
      }
      // Subir el anexo de aumento FIRMADO: pendiente_firma → pendiente_bodega.
      function esFirmaAnexoGestion() {
        return userRole() in ["administrador","gerente","vendedor","recepcion"]
          && resource.data.estado == "pendiente_firma"
          && request.resource.data.estado == "pendiente_bodega"
          && soloTocaG(["estado","cierre","anexo_firmado_path","anexo_firmado_at","anexo_firmado_por"]);
      }
      // Vincular el enlace de firma digital del anexo.
      function esEnlaceFirmaGestion() {
        return userRole() in ["administrador","gerente","vendedor","recepcion"]
          && soloTocaG(["firma_solicitud_id","firma_solicitud_estado"]);
      }
      // Bodega asigna seriales: items (reemplazo) o los seriales_asignados
      // anidados de demo/aumento.
      function esAsignacionGestion() {
        return userRole() in ["administrador","inventario"]
          && (soloTocaG(["items"]) || soloTocaG(["demo"]) || soloTocaG(["aumento"]));
      }
      allow read:   if isSignedIn() && userRole() in ["administrador","gerente","vendedor","recepcion","inventario","tecnico","jefe_taller","contabilidad"];
      allow create: if isSignedIn() && userRole() in ["administrador","gerente","vendedor","recepcion"]
                    && request.resource.data.cliente_id is string
                    && request.resource.data.tipo in ["reemplazo","demo","baja","aumento","devolucion","cambio_serial"]
                    && request.resource.data.deleted == false;
      allow update: if isSignedIn() && (
                      esAprobacionGestion() || esAnulacionGestion() || esCartaGestion()
                      || esFirmaAnexoGestion() || esEnlaceFirmaGestion() || esAsignacionGestion());
      allow delete: if false;
      // Linaje del reemplazo (espejo del patrón contratos/{cid}/mapeos):
      // append-only — onMapeoWrite generalizado los consume en la Ola 2.
      match /mapeos/{mapeoId} {
        allow read:   if isSignedIn();
        allow create: if isSignedIn() && userRole() in ["administrador","gerente","vendedor","recepcion","inventario"];
        allow update, delete: if false;
      }
      // Bitácora del expediente: quién hizo qué. Append-only.
      match /eventos/{eventoId} {
        allow read:   if isSignedIn();
        allow create: if isSignedIn() && userRole() in ["administrador","gerente","vendedor","recepcion","inventario","tecnico","jefe_taller"];
        allow update, delete: if false;
      }
    }
    // Firma digital de contratos (2026-08-28): el doc ES el enlace portador
    // (id imposible de adivinar). El cliente firma SIN sesión: get abierto
    // (list cerrado — sin el id no hay nada que leer) y una ÚNICA transición
    // pública pendiente→firmado que solo toca los campos de la firma. La
    // validación del firmante (cuando no coincide con el representante) y la
    // cancelación son de personal autenticado. onFirmaContrato hace el resto
    // con Admin SDK (activar el contrato, correos, ficha).
    match /firma_solicitudes/{sid} {
      allow get:  if true;
      allow list: if false;
      allow create: if isSignedIn()
        && userRole() in ["administrador","gerente","vendedor"]
        && request.resource.data.estado == "pendiente"
        && request.resource.data.contrato_doc_id is string;
      allow update: if
        // El firmante (público): pendiente → firmado, solo campos de la firma.
        (resource.data.estado == "pendiente"
          && request.resource.data.estado == "firmado"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado","firma"])
          && request.resource.data.firma.acepta == true
          && request.resource.data.firma.nombre is string
          && request.resource.data.firma.nombre.size() > 2
          && request.resource.data.firma.cedula is string
          && request.resource.data.firma.png is string
          && request.resource.data.firma.png.size() < 900000)
        // Ventas valida un firmante distinto al registrado: validacion → aceptado.
        || (isSignedIn() && userRole() in ["administrador","gerente"]
          && resource.data.estado == "validacion"
          && request.resource.data.estado == "aceptado"
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["estado","validado_por_uid","validado_at","actualizar_ficha"]))
        // Cancelar un enlace pendiente (se generó por error / venció el trato).
        || (isSignedIn() && userRole() in ["administrador","gerente","vendedor"]
          && resource.data.estado == "pendiente"
          && request.resource.data.estado == "cancelado"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado"]));
      allow delete: if isAdmin();
    }
    // Firma en TABLET del acuse de devolución (2026-09-01): recepción "manda"
    // la firma a la tablet del mostrador (Lenovo TB311XU con sesión iniciada,
    // /firmar/tablet.html), que ESCUCHA las solicitudes pendientes en vivo y
    // el cliente firma ahí. A diferencia de firma_solicitudes (enlace portador
    // público), aquí TODO es personal autenticado: list abierto a la sesión
    // (la tablet consulta estado=='pendiente') y transiciones cerradas:
    // pendiente → firmada (la tablet, solo estado+firma) o pendiente →
    // cancelada (recepción cierra la espera). La firma sube a Storage
    // (ordenes_firmas/, PNG <1MB) y aquí solo viaja la URL.
    match /firmas_tablet/{fid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && userRole() in ["administrador","vendedor","recepcion","tecnico","tecnico_operativo","jefe_taller"]
        && request.resource.data.estado == "pendiente"
        // acuse_devolucion (check-in de devolución), recepcion (acuse de
        // recibo en mostrador) y entrega (nota de entrega) — los tres flujos
        // de mostrador donde el cliente firma.
        && request.resource.data.tipo in ["acuse_devolucion", "recepcion", "entrega"]
        && request.resource.data.orden_id is string;
      allow update: if isSignedIn() && (
        (resource.data.estado == "pendiente"
          && request.resource.data.estado == "firmada"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado","firma"])
          && request.resource.data.firma.nombre is string
          && request.resource.data.firma.nombre.size() > 2
          && request.resource.data.firma.url is string)
        || (resource.data.estado == "pendiente"
          && request.resource.data.estado == "cancelada"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado"]))
        // Recepción corrige el correo de la copia MIENTRAS el cliente firma:
        // solo copia_a, solo en pendiente (una firmada ya es constancia).
        || (resource.data.estado == "pendiente"
          && request.resource.data.estado == "pendiente"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["copia_a"])));
      allow delete: if isAdmin();
    }
    // empresa/config guarda parámetros sensibles: umbrales de auto-envío de
    // cotizaciones (descuento_max_pct, total_max), seriales_editores_extra
    // (allowlist que salta el candado de seriales) e itbms_rate (tasa fiscal).
    // Solo admin lo escribe. El resto de docs de empresa (estado_de_reparacion,
    // operadores, emisor, tecnicos…) es config operativa que el staff edita
    // desde las páginas de configuración, así que conserva write autenticado.
    match /empresa/{docId} {
      allow read:  if isSignedIn();
      // facturacion_config (auto-activación, alertas, ítems QBO globales) era
      // escribible por cualquier autenticado y sus toggles solo se gateaban en
      // UI (H8) — ahora admin/contabilidad, igual que las páginas que lo editan.
      allow write: if isSignedIn()
        && (docId == "config" ? isAdmin()
            : (docId == "facturacion_config"
                ? userRole() in ["administrador", "contabilidad"]
                : true));
    }
    // Conteo de inventario: lo escriben SOLO las páginas de inventario
    // (cargar-inventario/inventario-index), gated a admin/inventario. Restringir
    // aquí cierra que cualquier rol corrompa los conteos.
    match /inventario_actual/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && userRole() in ["administrador","inventario"];
    }
    match /ultimo_inventario/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && userRole() in ["administrador","inventario"];
    }
    // inventario_piezas: el stock lo ajusta el flujo de órdenes (ajustarDelta),
    // así que create/stock quedan abiertos al staff. Lo que SÍ se cierra (H8)
    // son los campos de precio y mapeo QBO — los editan solo los catálogos
    // (piezas.html: admin/inventario; piezas-tarifas: admin/contabilidad).
    match /inventario_piezas/{docId} {
      allow read, create: if isSignedIn();
      allow update: if isSignedIn()
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(["precio_venta", "costo_unitario", "qbo_item_id",
                       "qbo_item_name", "precio_historial"])
            || userRole() in ["administrador", "inventario", "contabilidad"]);
      // Eliminar ya era solo-admin en la UI (piezas.js); ahora también aquí.
      allow delete: if isAdmin();
    }
    match /poc_logs/{docId}           { allow read, write: if isSignedIn(); }
    // Snapshots de borrado de grupos (admin/grupos.html): quién borró qué
    // grupo y de cuáles equipos, para poder deshacer (restaurarGrupo). El
    // staff crea/actualiza (marca restaurado); borrar el historial es admin.
    match /poc_grupos_historial/{docId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
    match /analytics_piezas_modelo/{docId} { allow read, write: if isSignedIn(); }
    // La cola de correo contiene PII (destinatarios, cuerpos con datos de
    // clientes/contratos). Lectura y administración solo admin/gerente; el
    // `create` queda abierto al staff autenticado porque cotizaciones y órdenes
    // encolan correos vía MailService.enqueue(). El saneo de `attachments`
    // (LFI/SSRF) se hace server-side en functions/src/lib/mail.js.
    match /mail_queue/{docId} {
      allow read:           if isSignedIn() && userRole() in ["administrador","gerente"];
      allow create:         if isSignedIn();
      allow update, delete: if isSignedIn() && userRole() in ["administrador","gerente"];
    }
    // Solo lo escribe Cloud Functions (onComplete, admin SDK). El frontend
    // únicamente lo LEE (UsuariosService.getTecnicoStats → .get()). Cerramos la
    // escritura de cliente: ningún rol puede inflar/corromper stats de técnicos.
    match /tecnico_stats/{docId} {
      allow read:  if isSignedIn();
      allow write: if false;
      match /{sub=**} { allow read: if isSignedIn(); allow write: if false; }   // mensual, semanal, eventos
    }

    // Collection-group query sobre `eventos` (ranking de progreso-tecnicos:
    // UsuariosService.getEventosCountSince → db.collectionGroup('eventos')).
    // OJO: la regla de subcolección con wildcard recursivo de arriba NO autoriza
    // collection-group queries — Firestore exige una regla dedicada con el id de
    // colección como segmento literal precedido por {path=**}. Sin esto la query
    // falla con "Missing or insufficient permissions". El único `eventos` del
    // proyecto vive en tecnico_stats/{key}/eventos (lo escribe el trigger
    // onComplete vía admin SDK), así que basta read para autenticados.
    match /{path=**}/eventos/{eventoId} {
      allow read: if isSignedIn();
    }

    // Solicitudes de reseteo desde login.html. Hoy se intentan SIN sesión y
    // fallan silenciosamente (best-effort, try/catch). Se preserva ese estado.
    match /reset_requests/{docId}     { allow read, write: if isSignedIn(); }

    // ── Reporte KPIs junta directiva (admin/kpi-reportes) ─────────────────
    // Un doc por mes (ID YYYY-MM) con las métricas del reporte ejecutivo a la
    // junta (ingresos QBO, suscriptores, churn) + comentarios de gerencia.
    // Data financiera sensible: lectura Y escritura solo administradores.
    match /kpi_reports/{mes} {
      allow read, write: if isAdmin();
    }

    // ── Reportes de conciliación (cron conciliacionPool → Admin · Salud) ───
    // Escritos SOLO por Cloud Functions (admin SDK); el frontend solo lee.
    match /admin_reportes/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Integración QuickBooks — SOLO Cloud Functions (admin SDK) ──────────
    // `integraciones/quickbooks` guarda tokens OAuth (access/refresh) y realmId;
    // `integraciones_qbo_oauth_states` son states CSRF efímeros;
    // `qbo_webhook_events` son eventos crudos del webhook entrante.
    // NINGÚN frontend debe leerlos ni escribirlos: deny explícito. Sin catch-all
    // estarían denegadas igual, pero esto lo documenta y previene aflojarlas.
    match /integraciones/{docId}                  { allow read, write: if false; }
    match /integraciones_qbo_oauth_states/{docId} { allow read, write: if false; }
    match /qbo_webhook_events/{docId}             { allow read, write: if false; }
  }
}
